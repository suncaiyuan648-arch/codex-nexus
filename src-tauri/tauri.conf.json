{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage Monitor",
  "version": "0.1.0",
  "identifier": "com.local.codexusagemonitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Usage Monitor",
        "width": 760,
        "height": 680,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
